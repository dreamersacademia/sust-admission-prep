rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }
    function isOwner(authUid) {
      return isSignedIn() && request.auth.uid == authUid;
    }

    // ---- students -----------------------------------------------------
    // A student can read their OWN profile (to know their unit permission,
    // track, name). All writes — including creation — happen only via the
    // Admin SDK (bulk CSV upload, single-add), never from the client.
    match /students/{studentId} {
      allow read: if isAdmin() || isOwner(resource.data.authUid);
      allow write: if false;
    }

    // ---- admins ---------------------------------------------------------
    // Managed entirely out-of-band (Firebase console / a one-time setup
    // script with the Admin SDK). No client path ever creates an admin.
    match /admins/{adminUid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---- exams ------------------------------------------------------------
    // Metadata only (title, unit, window, duration, totals) — NEVER
    // contains questions or answer keys, so it's safe for any signed-in
    // student to read. The public exam page reads this too, unauthenticated,
    // but ONLY when isPublic == true.
    match /exams/{examId} {
      allow read: if isSignedIn() || resource.data.isPublic == true;
      allow write: if isAdmin();
    }

    // ---- questions (and answer keys) ---------------------------------------
    // THE spec requirement: client-read disabled, full stop. No student,
    // guest, or even a signed-in non-admin ever reads this collection
    // directly. All access is through the Next.js API routes below, which
    // use the Admin SDK (which bypasses these rules entirely) to fetch a
    // SANITIZED copy (no correctIndex/explanation) during a live exam, and
    // the full copy only after the exam window has closed.
    match /exams/{examId}/questions/{questionId} {
      allow read, write: if false;
    }

    // ---- attempts -----------------------------------------------------------
    // Also client-read disabled, per spec — a student never reads their own
    // attempt doc directly (that would let them poll for correctIndex before
    // the official reveal, or infer timing of the server grading). All
    // attempt creation, submission, and result retrieval goes through the
    // API routes, authenticated via the Admin SDK's verified ID token.
    // Admins CAN read attempts directly, for review (tab-switch flags etc).
    match /attempts/{attemptId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---- leaderboards ---------------------------------------------------
    // Public once published (readable with NO auth — guests need this too,
    // and results get shared on social media per the spec). Only the API
    // route (Admin SDK) writes it, once for a given exam, when the window
    // closes.
    match /leaderboards/{examId} {
      allow read: if resource.data.published == true;
      allow write: if false;
    }
  }
}
